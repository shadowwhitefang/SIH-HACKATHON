{
  "name": "civictrack",
  "version": "1.0.0",
  "description": "CivicTrack — MP Accountability & Fund Monitoring Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev": "vite",
    "dev:server": "nodemon server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "bundle": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/main.jsx'], bundle: true, outfile: 'react-app.bundle.js', loader: { '.jsx': 'jsx' } })\"",
    "preview": "vite preview",
    "seed": "node server/seed/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "civictrack",
    "mplads",
    "accountability",
    "transparency",
    "fund-monitoring"
  ],
  "author": "CivicTrack Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "vite": "^5.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  }
}